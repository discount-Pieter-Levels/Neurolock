# Hand-written equivalent of risc0-build 3.0.5 create_dockerfile() (cargo risczero build),
# because risc0-build asks the host rzup for the toolchain version even in docker mode.
FROM docker.io/risczero/risc0-guest-builder:r0.1.91.1 AS build
WORKDIR /src
COPY . .
ENV CARGO_MANIFEST_PATH=Cargo.toml CARGO_TARGET_DIR=target RISC0_FEATURE_bigint2= \
    CC_riscv32im_risc0_zkvm_elf=/root/.risc0/cpp/bin/riscv32-unknown-elf-gcc \
    CFLAGS_riscv32im_risc0_zkvm_elf="-march=rv32im -nostdlib"
RUN cargo +risc0 fetch --locked --target riscv32im-risc0-zkvm-elf --manifest-path $CARGO_MANIFEST_PATH
RUN export CARGO_ENCODED_RUSTFLAGS="$(printf '%s\037' -C passes=lower-atomic -C link-arg=-Ttext=0x00200800 -C link-arg=--fatal-warnings -C panic=abort --cfg 'getrandom_backend="custom"' | sed 's/\x1f$//')" && \
    cargo +risc0 build --release --locked --target riscv32im-risc0-zkvm-elf --manifest-path $CARGO_MANIFEST_PATH
